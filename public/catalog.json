  "news": [
    {
      "id": "simuladores-mejoras-2025",
      "author": "Bonju",
      "role": "The Xpedition Host",
      "title": "Nuevos Simuladores & Mejoras en Antiguos",
      "text": "La familia de simuladores crece con The Traitor Simulator y The Xpedition House. El primero toma la tensión del spin off The Traitor y la convierte en una experiencia de sospechas, pactos y traiciones; el segundo se inspira en la convivencia tipo Big Brother, con alianzas, drama social y momentos impredecibles. Además, los simuladores antiguos reciben ajustes visuales, fondos mejor integrados y una navegación más clara.",
      "imageName": "Bonju"
    },
    {
      "id": "traitor-2-pagina-oficial",
      "author": "Bonju",
      "role": "The Xpedition Host",
      "title": "¡The Traitor 2 ya tiene página oficial!",
      "text": "The Traitor 2 abre oficialmente su espacio dentro del universo The Xpedition. La nueva página reunirá noticias, participantes, momentos clave y todo lo necesario para seguir una temporada cargada de secretos, sospechas y decisiones capaces de cambiar el juego en segundos.",
      "imageName": "Bonju"
    },
    {
      "id": "bonju-camp-awards",
      "author": "Bonju",
      "role": "The Xpedition Host",
      "title": "Bonju fue galardonada como Mejor Host virtual",
      "text": "Bonju fue galardonada como Mejor Host virtual en los Camp Awards, reforzando su lugar como una de las figuras más queridas y reconocibles del universo The Xpedition. El reconocimiento celebra su presencia, su estilo para conducir la competencia y la forma en que acompaña cada giro importante de la franquicia.",
      "imageName": "Bonju"
    },
    {
      "id": "xpedition-japan-location",
      "author": "Bonju",
      "role": "The Xpedition Host",
      "title": "La próxima temporada de The Xpedition ya tiene locación",
      "text": "La próxima temporada viajará a Japón, un destino conocido por su mezcla de tradición, tecnología, disciplina, cultura pop, gastronomía y paisajes icónicos. Esta nueva etapa promete retos con identidad propia, twists más intensos, drama estratégico y una atmósfera donde cada decisión puede sentirse como un choque entre honor, ambición y supervivencia.",
      "imageName": "Bonju"
    },
    {
      "id": "ignacio-ricci-showdown-2-winner",
      "author": "Bonju",
      "role": "The Xpedition Host",
      "title": "Ignacio Ricci se consagró como el ganador de Safari Showdown 2",
      "text": "Ignacio Ricci ganó el especial de reunión de Safari Showdown 2 y cerró la noche con una victoria contundente. Además del premio de 20 dólares, obtuvo un pase directo a la próxima temporada, convirtiéndose en una de las figuras a seguir para lo que viene.",
      "imageName": "Bonju"
    },
    {
      "id": "julian-fuera-final-safari",
      "author": "Bonju",
      "role": "The Xpedition Host",
      "title": "¡Julián queda fuera de la final de Safari!",
      "text": "Después de un reto cargado de tensión, presión y decisiones al límite, Julián quedó fuera de la final de Safari. Con su eliminación, Peggy y Coronel se consolidan como el top 2 de una recta final marcada por rivalidad, resistencia y mucho nervio competitivo.",
      "imageName": "Bonju"
    },
    {
      "id": "safari-regreso-2025",
      "author": "Bonju",
      "role": "The Xpedition Host",
      "title": "Safari regresó en 2025",
      "text": "Después de dos años, Safari regresó para una segunda parte de 15 episodios con participantes nuevos, mecánicas renovadas, twists más agresivos y una dosis fresca de drama. La temporada reactivó el espíritu salvaje de la saga y volvió a poner a prueba el instinto de quienes entraron por la victoria.",
      "imageName": "Bonju"
    },
    {
      "id": "dani-ganadora-antarctica",
      "author": "Bonju",
      "role": "The Xpedition Host",
      "title": "Dani es la ganadora de The Xpedition Antarctica",
      "text": "Después de 18 episodios, 4 fases y una ruta llena de retos, drama, sorpresas y decisiones difíciles, Dani se convirtió en la ganadora de The Xpedition Antarctica. Su recorrido combinó resistencia, lectura social y momentos clave que la llevaron a cerrar la primera temporada con una victoria histórica.",
      "imageName": "Bonju"
    }
  ],
